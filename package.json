{
  "name": "event-mod-bot",
  "version": "1.0.0",
  "description": "Discord bot: moderation + welcomer + multi-event roster signup panels",
  "main": "index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "prestart": "node scripts/ensure-deps.js",
    "start": "node run.js",
